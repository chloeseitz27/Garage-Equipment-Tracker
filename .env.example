# Copy to .env and fill in. Never commit .env.
# Only the Express process reads these — no VITE_ prefix, ever (technical-spec.md §9.1).

# --- Server ---
PORT=3001

# --- Storage (technical-spec.md §4) ---
# json   = local files under data/runtime (default, no Azure needed)
# cosmos = Azure Cosmos DB
STORAGE=json

# Only used when STORAGE=cosmos.
# Get the endpoint from the deploy script output, or:
#   az cosmosdb show -n <account> -g garage-inventory --query documentEndpoint -o tsv
COSMOS_ENDPOINT=
COSMOS_DATABASE=garage
COSMOS_CONTAINER=catalog
# Leave COSMOS_KEY empty. Auth then uses DefaultAzureCredential — managed
# identity in Azure, your `az login` locally — so no secret exists to leak.
# The Bicep template sets disableLocalAuth, so a key will be REJECTED even if
# you paste one here. Grant access with a data-plane role instead; note that
# Cosmos data-plane RBAC is separate from Azure RBAC, so Subscription Owner
# alone grants nothing.
COSMOS_KEY=

# --- Staff auth (technical-spec.md §8) ---
# Shared passphrase for the hackathon demo. Not a production answer.
STAFF_PASSPHRASE=
# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Idle session expiry, in minutes.
SESSION_TTL_MINUTES=30

# --- Project Assistant (technical-spec.md §6.3) ---
# stub | azure-openai | github-models
# "stub" needs no key and no network. Start here.
ASSISTANT_PROVIDER=stub
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
