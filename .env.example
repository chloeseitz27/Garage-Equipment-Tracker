# Copy to .env and fill in. Never commit .env.
# Only the Express process reads these — no VITE_ prefix, ever (technical-spec.md §9.1).

# --- Server ---
PORT=3001

# --- Staff auth (technical-spec.md §8) ---
# Shared passphrase for the hackathon demo. Not a production answer.
STAFF_PASSPHRASE=
# Secret used to sign the session cookie. Any long random string.
SESSION_SECRET=
# Idle session expiry, in minutes.
SESSION_TTL_MINUTES=30

# --- Project Assistant (technical-spec.md §6.3) ---
# stub | azure-openai | github-models
# "stub" needs no key and no network. Start here.
ASSISTANT_PROVIDER=stub
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
